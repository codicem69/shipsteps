<content>&lt;div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px; color: #1a202c; margin-left: 20px; margin-top: 30px; width: 85%; max-width: 800px; background: #ffffff; border: 1px solid #cbd5e0; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow: hidden;"&gt;
    
    &lt;!-- Testata Principale --&gt;
    &lt;div style="background: #f7fafc; padding: 16px 20px; border-bottom: 1px solid #cbd5e0;"&gt;
        &lt;span style="font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: #4a5568; font-weight: 600; display: block; margin-bottom: 2px;"&gt;Vessel Name&lt;/span&gt;
        &lt;strong style="font-size: 20px; color: #1a202c; font-weight: 700;"&gt;$vessel_imbarcazione_tipo $vessel_imbarcazione_nome&lt;/strong&gt;
    &lt;/div&gt;

    &lt;!-- Griglia Dati Principali --&gt;
    &lt;table style="width: 100%; border-collapse: collapse;"&gt;
        &lt;tbody&gt;
            &lt;tr&gt;
                &lt;td style="padding: 12px 20px; border-bottom: 1px solid #e2e8f0; width: 33.33%;"&gt;
                    &lt;span style="display:block; font-size: 11px; color: #4a5568; text-transform: uppercase; font-weight: 600; margin-bottom: 3px;"&gt;Bandiera&lt;/span&gt;
                    &lt;strong style="color: #1a202c;"&gt;$vessel_imbarcazione_flag_codename&lt;/strong&gt;
                &lt;/td&gt;
                &lt;td style="padding: 12px 20px; border-bottom: 1px solid #e2e8f0; width: 33.33%;"&gt;
                    &lt;span style="display:block; font-size: 11px; color: #4a5568; text-transform: uppercase; font-weight: 600; margin-bottom: 3px;"&gt;IMO&lt;/span&gt;
                    &lt;strong style="color: #1a202c;"&gt;$vessel_imbarcazione_imo&lt;/strong&gt;
                &lt;/td&gt;
                &lt;td style="padding: 12px 20px; border-bottom: 1px solid #e2e8f0; width: 33.33%;"&gt;
                    &lt;span style="display:block; font-size: 11px; color: #4a5568; text-transform: uppercase; font-weight: 600; margin-bottom: 3px;"&gt;Call Sign&lt;/span&gt;
                    &lt;strong style="color: #1a202c;"&gt;$vessel_imbarcazione_vessel_details_callsign&lt;/strong&gt;
                &lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td style="padding: 12px 20px; border-bottom: 1px solid #e2e8f0;"&gt;
                    &lt;span style="display:block; font-size: 11px; color: #4a5568; text-transform: uppercase; font-weight: 600; margin-bottom: 3px;"&gt;Stazza (GT / NT / DWT)&lt;/span&gt;
                    &lt;strong style="color: #1a202c;"&gt;$vessel_imbarcazione_gt&lt;/strong&gt; &lt;span style="color:#a0aec0;"&gt;/&lt;/span&gt; &lt;strong&gt;$vessel_imbarcazione_nt&lt;/strong&gt; &lt;span style="color:#a0aec0;"&gt;/&lt;/span&gt; &lt;strong&gt;$vessel_imbarcazione_vessel_details_dwt&lt;/strong&gt;
                &lt;/td&gt;
                &lt;td style="padding: 12px 20px; border-bottom: 1px solid #e2e8f0;"&gt;
                    &lt;span style="display:block; font-size: 11px; color: #4a5568; text-transform: uppercase; font-weight: 600; margin-bottom: 3px;"&gt;Dimensioni (LOA / Beam)&lt;/span&gt;
                    &lt;strong style="color: #1a202c;"&gt;$vessel_imbarcazione_loa&lt;/strong&gt; &lt;span style="color:#a0aec0;"&gt;x&lt;/span&gt; &lt;strong&gt;$vessel_imbarcazione_vessel_details_beam&lt;/strong&gt;
                &lt;/td&gt;
                &lt;td style="padding: 12px 20px; border-bottom: 1px solid #e2e8f0;"&gt;
                    &lt;span style="display:block; font-size: 11px; color: #4a5568; text-transform: uppercase; font-weight: 600; margin-bottom: 3px;"&gt;Built / MMSI&lt;/span&gt;
                    &lt;strong style="color: #1a202c;"&gt;$vessel_imbarcazione_vessel_details_built&lt;/strong&gt; &lt;span style="color:#a0aec0;"&gt;|&lt;/span&gt; &lt;strong&gt;$vessel_imbarcazione_vessel_details_mmsi&lt;/strong&gt;
                &lt;/td&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
                &lt;td style="padding: 12px 20px; border-bottom: 1px solid #e2e8f0;"&gt;
                    &lt;span style="display:block; font-size: 11px; color: #4a5568; text-transform: uppercase; font-weight: 600; margin-bottom: 3px;"&gt;Reg. Place&lt;/span&gt;
                    &lt;strong style="color: #1a202c;"&gt;$reg_place&lt;/strong&gt;
                &lt;/td&gt;
                &lt;td style="padding: 12px 20px; border-bottom: 1px solid #e2e8f0;"&gt;
                    &lt;span style="display:block; font-size: 11px; color: #4a5568; text-transform: uppercase; font-weight: 600; margin-bottom: 3px;"&gt;Reg. Number&lt;/span&gt;
                    &lt;strong style="color: #1a202c;"&gt;$reg_num&lt;/strong&gt;
                &lt;/td&gt;
                &lt;td style="padding: 12px 20px; border-bottom: 1px solid #e2e8f0;"&gt;
                    &lt;span style="display:block; font-size: 11px; color: #4a5568; text-transform: uppercase; font-weight: 600; margin-bottom: 3px;"&gt;Propellers (Stern / Bow)&lt;/span&gt;
                    &lt;strong style="color: #1a202c;"&gt;$eliche_poppa&lt;/strong&gt; &lt;span style="color:#a0aec0;"&gt;/&lt;/span&gt; &lt;strong&gt;$eliche_prua&lt;/strong&gt;
                &lt;/td&gt;
            &lt;/tr&gt;
        &lt;/tbody&gt;
    &lt;/table&gt;

    &lt;!-- Sezione Owner e Note --&gt;
    &lt;div style="padding: 16px 20px; background: #fafafa; border-top: 1px solid #cbd5e0;"&gt;
        &lt;div style="margin-bottom: 10px;"&gt;
            &lt;span style="font-size: 11px; color: #4a5568; text-transform: uppercase; font-weight: 600;"&gt;Owner:&lt;/span&gt;
            &lt;strong style="color: #1a202c; margin-left: 6px;"&gt;$vessel_imbarcazione_vessel_details_armatore_own_fullname&lt;/strong&gt;
        &lt;/div&gt;
        &lt;div style="border-top: 1px dashed #cbd5e0; padding-top: 10px; margin-top: 10px;"&gt;
            &lt;span style="font-size: 11px; color: #4a5568; text-transform: uppercase; font-weight: 600; display: block; margin-bottom: 4px;"&gt;Vessel Note:&lt;/span&gt;
            &lt;span style="color: #2d3748; font-style: italic; line-height: 1.5;"&gt;$vessel_vess_note&lt;/span&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;
</content>
